<Window x:Class="LiuYingPet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="流萤桌宠"
        Width="240"
        Height="270"
        MinWidth="160"
        MinHeight="180"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseLeftButtonUp="Window_MouseLeftButtonUp"
        MouseMove="Window_MouseMove">
    <Grid x:Name="Root" Background="Transparent">
        <Canvas x:Name="Stage" Width="220" Height="250" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid x:Name="SpriteRoot"
                  Width="200"
                  Height="220"
                  Canvas.Left="10"
                  Canvas.Top="22"
                  RenderTransformOrigin="0.5,0.82">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="SpriteScale" ScaleX="1" ScaleY="1" />
                        <RotateTransform x:Name="SpriteRotate" Angle="0" />
                        <TranslateTransform x:Name="SpriteTranslate" X="0" Y="0" />
                    </TransformGroup>
                </Grid.RenderTransform>

                <Image x:Name="SpriteImage"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Visibility="Collapsed" />

                <Grid x:Name="FallbackPet" Width="200" Height="220" Visibility="Visible">
                    <Ellipse Width="118"
                             Height="104"
                             Fill="#F2FFFC"
                             Stroke="#31535A"
                             StrokeThickness="4"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Top"
                             Margin="0,20,0,0" />
                    <Path Data="M42,72 C50,25 82,8 112,20 C142,10 164,36 160,78 C134,52 88,55 42,72 Z"
                          Fill="#C9FFF5"
                          Stroke="#31535A"
                          StrokeThickness="3"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Top"
                          Margin="0,14,0,0" />
                    <Ellipse Width="16" Height="22" Fill="#37C6B8" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="-36,70,0,0" />
                    <Ellipse Width="16" Height="22" Fill="#37C6B8" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="36,70,0,0" />
                    <Ellipse Width="5" Height="7" Fill="#F8FFFF" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="-41,75,0,0" />
                    <Ellipse Width="5" Height="7" Fill="#F8FFFF" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="31,75,0,0" />
                    <Path Data="M92,100 C100,108 110,108 118,100"
                          Stroke="#31535A"
                          StrokeThickness="3"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Fill="Transparent" />
                    <Border Width="94"
                            Height="82"
                            CornerRadius="26"
                            Background="#F8FFFF"
                            BorderBrush="#31535A"
                            BorderThickness="4"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Margin="0,124,0,0">
                        <Grid>
                            <Path Data="M12,22 C34,4 60,4 82,22 L58,70 L36,70 Z" Fill="#1E3540" />
                            <Path Data="M39,18 L55,18 L62,68 L32,68 Z" Fill="#8CF5E7" Opacity="0.95" />
                        </Grid>
                    </Border>
                    <TextBlock Text="流萤"
                               Foreground="#31535A"
                               FontWeight="Bold"
                               FontSize="15"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Bottom"
                               Margin="0,0,0,2" />
                </Grid>
            </Grid>

            <Border x:Name="StatusBubble"
                    Canvas.Left="14"
                    Canvas.Top="0"
                    Width="192"
                    MinHeight="32"
                    Padding="10,6"
                    CornerRadius="16"
                    Background="#EFFFFFFF"
                    BorderBrush="#6531535A"
                    BorderThickness="1"
                    Opacity="0">
                <TextBlock x:Name="StatusText"
                           Text="缺少素材"
                           Foreground="#243A40"
                           FontSize="12"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           TextAlignment="Center" />
            </Border>
        </Canvas>
    </Grid>
</Window>
